#!/bin/sh
#
# Mirror the DHCPv6 delegated prefix address onto the PPP interface.
#
# dhcpcd cannot assign a delegated prefix to the interface that requested it,
# so the prefix is delegated to a dummy interface (pdN) and dhcpcd runs this
# hook for pdN with reason DELEGATED6. pppN is where nftables masquerades to,
# so the same address is also configured there.

case "$reason" in
DELEGATED6 | BOUND6 | RENEW6 | REBIND6 | REBOOT6) ;;
*) exit 0 ;;
esac

[ -n "$new_delegated_dhcp6_prefix" ] || exit 0

case "$interface" in
pd*) ppp="ppp${interface#pd}" ;;
ppp*) ppp="$interface" ;;
*) exit 0 ;;
esac

for addr in $new_delegated_dhcp6_prefix; do
	ip -6 addr replace "$addr" dev "$ppp" nodad || continue
	echo "ppproxy: delegated prefix $addr assigned to $ppp"
done

exit 0
